    "@pdf-lib/fontkit": "^1.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "perfect-freehand": "^1.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=22"
  }
